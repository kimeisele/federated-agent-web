  "package": "conformance/v0.2",
  "defaults": {
    "now": "2026-01-01T00:00:00Z",
    "trust_chain": {
      "head": "the last manifest of the ordered trust_chain array",
      "head_sequence": "head.body.manifest_sequence",
      "head_digest": "sha256:<hex> of JCS(head without top-level signature)",
      "pinned_at": "explicit per-fixture verification input (see fixtures[].pinned_at); never chosen implicitly by the consumer",
      "freshness": "fresh iff pinned_at + head.body.manifest_freshness_window_seconds > now; otherwise stale (local policy may reject or qualify, never silently pass)"
    },
    "local_policy": {
      "contract": "fixtures[].local_policy encodes every admission-policy input required to reproduce verification; consumers construct their policy from these values alone and must not inherit implicit defaults",
      "fields": [
        "clock_skew_seconds",
        "reject_stale",
        "can_enforce_tokens",
        "can_enforce_cost",
        "allowed_external_effects",
        "allowed_actions",
        "capability_targets",
        "max_wall_seconds_cap",
        "max_output_bytes_cap"
      ]
    },
    "verification": "document bytes + expected_kind + trust_chain (ordered manifest array) + now + pinned_at + local_node_id (delegations) + local_policy + optional semantic pending context (receipts)"
  },
